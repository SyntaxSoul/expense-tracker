<changeSet id="006-create-income-table" author="Vinu">
    <createTable tableName="income">
        <column name="id" type="BIGINT" autoIncrement="true">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="account_id" type="BIGINT">
            <constraints nullable="false"/>
        </column>
        <column name="source" type="VARCHAR(100)">
            <constraints nullable="false"/>
        </column>
        <column name="amount" type="DECIMAL(10,2)">
            <constraints nullable="false"/>
        </column>
        <column name="income_date" type="DATE">
            <constraints nullable="false"/>
        </column>
        <column name="created_at" type="TIMESTAMP">
            <constraints nullable="false"/>
        </column>
    </createTable>

    <createIndex indexName="idx_income_accounts_id" tableName="income">
        <column name="account_id"/>
    </createIndex>
    <createIndex indexName="idx_income_created_date" tableName="income">
        <column name="created_date"/>
    </createIndex>

    <addForeignKeyConstraint
        constraintName="fk_income_accounts"
        baseTableName="income"
        baseColumnNames="account_id"
        referencedTableName="accounts"
        referencedColumnNames="id"
        />

    <rollback>
        <dropTable tableName="income"/>
    </rollback>
</changeSet>